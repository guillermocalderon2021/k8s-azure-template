# Copiar como terraform.tfvars y reemplazar los valores.
# Consultar suscripcion: az account show --query id -o tsv
subscription_id = "REEMPLAZAR_CON_ID_DE_SUSCRIPCION"

# IP publica individual seguida de /32; el siguiente valor es solo un ejemplo.
ssh_source_cidr = "203.0.113.10/32"

# Comprobar previamente cuota y region de Azure for Students.
location = "eastus2"
vm_size  = "Standard_B2s"

resource_prefix = "devops-k3s"
